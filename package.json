{
  "name": "app-bingo",
  "version": "3.0.0",
  "private": true,
  "description": "Bingo 3D con Three.js, GSAP y Tailwind",
  "scripts": {
    "build:js": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/app.js",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build": "npm run build:js && npm run build:css",
    "dev": "npm run build:css -- --watch & esbuild src/main.js --bundle --format=iife --outfile=dist/app.js --watch"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.1.0",
    "@fontsource/bungee": "^5.1.0",
    "esbuild": "^0.24.0",
    "gsap": "^3.12.5",
    "tailwindcss": "^3.4.16",
    "three": "^0.160.0"
  }
}

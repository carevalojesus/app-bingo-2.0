<?xml version="1.0" encoding="utf-8"?>
<!-- Accesos directos al mantener pulsado el icono (la «última sala» se añade al entrar en una) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="escanear"
        android:enabled="true"
        android:icon="@drawable/atajo_qr"
        android:shortcutShortLabel="@string/atajo_escanear"
        android:shortcutLongLabel="@string/atajo_escanear_largo">
        <intent
            android:action="pe.carevalojesus.bingoshow.ESCANEAR"
            android:targetPackage="pe.carevalojesus.bingoshow"
            android:targetClass="pe.carevalojesus.bingoshow.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="control"
        android:enabled="true"
        android:icon="@drawable/atajo_control"
        android:shortcutShortLabel="@string/atajo_control"
        android:shortcutLongLabel="@string/atajo_control_largo">
        <intent
            android:action="pe.carevalojesus.bingoshow.CONTROL"
            android:targetPackage="pe.carevalojesus.bingoshow"
            android:targetClass="pe.carevalojesus.bingoshow.MainActivity" />
    </shortcut>
</shortcuts>
